# 共享默认配置 · 已入库模板（2026-11-16 老罗定：其他地方 clone 下来就能跑）
# ⚑ 本文件不含任何密钥 / token，仓库 public，可以提交。
# ⚑ 本机私有值一律写 .env.local（.gitignore 已忽略，绝不提交）：
#     TIINGO_TOKEN / TICKFLOW_API_KEY / 自己改过的账户额度
# 读取优先级：进程 env > .env.local > .env > account_config.DEFAULTS
# 改完存盘即生效 —— 每次取值都检查 env 变化 / 文件 mtime，不写死在代码里。
# 策略常数（ATR/通道等）不在此文件；键位含义见下方各段。

# ── A 股组合额度（2026-09-21 定稿）──────────────────────────────
# 总仓位上限 100,000 = 主力 50,000 + 后备 50,000
#   主力：常规信号可用
#   后备：只有「突破预案单」级信号才够格动用（见 probe_intraday.ash_portfolio_gate）
ASH_PRIMARY=50000
ASH_RESERVE=50000
# 总上限：可写可不写；写了必须等于 PRIMARY + RESERVE，否则启动即报错
ASH_TOTAL=100000
# 单笔绝对额硬顶（A 股）。与上面的「总额度」是两回事：单笔封顶 5 万，组合可到 10 万
ASH_SINGLE_ABS=50000

# ── A 股单票探测账户 ────────────────────────────────────────
# ★ 这是「风险预算的分母」（1.5% = 750 元/笔）与股数计算的基数，不是可动用资金。
ASH_ACCOUNT=50000
ASH_RISK_PCT=0.015
# 可用现金（可选）：填了就按「付掉持仓占用后的现金」再封顶一次股数；留空 = 不启用
#ASH_CASH=28426

# ── 美股 ───────────────────────────────────────────────────
US_ACCOUNT=4694.80
US_RISK_PCT=0.015

# ── 美股分钟线代理（默认不设置 = 只直连）─────────────────────
# 也可不写这里，改在仓库根目录建 us_proxy.txt（一行代理 URL）。
# 强制不用代理：WB_US_PROXY=off 或 WB_NO_PROXY=1
#WB_US_PROXY=http://127.0.0.1:7897

# ── 本机私有密钥：以下键只写进 .env.local，绝不写进本文件 ────────
# TICKFLOW_API_KEY  tickflow 单票行情备选源（当前代码未直接消费，落地预留）
# TIINGO_TOKEN      美股夜盘实时参考价，免费 Starter $0/月：
#   ① 注册 https://api.tiingo.com → 右上角 Sign-up，验证邮箱
#   ② token 页 https://api.tiingo.com/account/api/token
#   ③ 写进 .env.local：TIINGO_TOKEN=你的token
# 只在夜盘 20:00–03:59 ET（北京 09:00–16:59）调用；其余时段一次请求都不发。
# 不配 ⇒ 夜盘 fail-closed：脚本正常运行但不出可执行买单（不拿昨收假价出单）。
# 免费层限额：500 标的/月 · 50 请求/小时 · 1000 请求/天 · 1 GB/月 · Internal Use Only
# ⚑ 合成派生参考价，不是可成交盘口；限价单按券商 BOATS 盘口校准。
# 报价滞留阈值（秒，默认 300）：TIINGO_MAX_STALE_SEC=300
