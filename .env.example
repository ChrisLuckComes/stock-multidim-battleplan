# 复制为 .env 后按自己的账户改。勿提交 .env。
# 未设置时使用括号内默认值。策略常数（ATR/通道等）不在此文件。

# A 股探测默认账户（也可 CLI: --account）
ASH_ACCOUNT=50000

# 美股探测默认账户美元（也可 CLI: --us-account）
# 美股无额外单笔比例上限，仓位只受本账户全额约束
US_ACCOUNT=5000

# 组合层：主力 + 备用；单笔绝对额硬顶（仅 A 股）
ASH_PRIMARY=50000
ASH_RESERVE=50000
ASH_SINGLE_ABS=50000

# 风险预算
ASH_RISK_PCT=0.015
US_RISK_PCT=0.015

# 美股分钟线（Yahoo）走的代理。**默认不设置 = 只直连，不会去探本机任何端口**。
# 需要走你自己的代理客户端时才填（端口照你客户端的实际设置写，别照抄示例）。
# 也可以不写在这里，改成在仓库根目录建 us_proxy.txt（内容同样是一行代理 URL）。
# 强制不用代理：WB_US_PROXY=off 或 WB_NO_PROXY=1
# （另有一个会被自动探端口的旧行为，需显式 WB_US_PROXY_AUTOPROBE=1 才开启，不建议）
#WB_US_PROXY=http://127.0.0.1:7897
