# 复制为 .env 后按自己的账户改。勿提交 .env（.gitignore 已忽略）。
# 未设置的键用 account_config.DEFAULTS。策略常数（ATR/通道等）不在此文件。
# 优先级：进程 env > 本文件 > DEFAULTS。
# 改完存盘即生效 —— 每次取值都会检查（env 变化 / 文件 mtime），不写死在代码里。

# ── A 股组合额度（2026-09-21 定稿）──────────────────────────────
# 总仓位上限 100,000 = 主力 50,000 + 后备 50,000
#   主力：常规信号可用
#   后备：只有「突破预案单」级信号才够格动用（见 probe_intraday.ash_portfolio_gate）
ASH_PRIMARY=50000
ASH_RESERVE=50000
# 总上限：可写可不写；写了必须等于 PRIMARY + RESERVE，否则启动即报错
# （宁可让你看见矛盾，也不让「配置里写的数」和「实际闸门」悄悄分叉）
ASH_TOTAL=100000
# 单笔绝对额硬顶（A 股）。与上面的「总额度」是两回事：单笔封顶 5 万，组合可到 10 万
ASH_SINGLE_ABS=50000

# ── A 股单票探测账户 ────────────────────────────────────────
# ★ 这是「风险预算的分母」（1.5% = 750 元/笔）与股数计算的基数，
#   不是可动用资金。可动用资金看上面的总额度。
ASH_ACCOUNT=50000
ASH_RISK_PCT=0.015

# 可用现金（可选）：填了就按「付掉持仓占用后的现金」再封顶一次股数
# （688152 就是这种情况：账户 5 万、已持 21,574，真正能动 28,426）。
# 留空/删掉 = 不启用该约束。持仓变动后记得改。
#ASH_CASH=28426

# ── 美股 ───────────────────────────────────────────────────
US_ACCOUNT=4694.80
US_RISK_PCT=0.015

# ── 美股分钟线代理（默认不设置 = 只直连）─────────────────────
# 需要走自己的代理客户端时才填（端口照你客户端的实际设置写，别照抄示例）。
# 也可不写这里，改在仓库根目录建 us_proxy.txt（一行代理 URL）。
# 强制不用代理：WB_US_PROXY=off 或 WB_NO_PROXY=1
#WB_US_PROXY=http://127.0.0.1:7897
